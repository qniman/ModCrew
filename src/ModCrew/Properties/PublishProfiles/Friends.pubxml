<?xml version="1.0" encoding="utf-8"?>
<!-- One ModCrew.exe for friends: no .NET install needed, UI embedded.
     dotnet publish src/ModCrew -p:PublishProfile=Friends  →  publish\ModCrew.exe -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- No package XML docs next to the exe. -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
